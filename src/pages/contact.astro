---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import EnquiryForm from "../components/EnquiryForm";
import { contact } from "../data/site";
import { withBase } from "../lib/paths";
import warehouse from "../assets/media/warehouse-coffee.webp";

const turnstileSitekey = "0x4AAAAAAFm-9A5kNe1el_X6";
const officeMapUrl = "https://www.google.com/maps?q=8.9933233,38.7279965&z=17&output=embed";
const officeDirectionsUrl = "https://maps.app.goo.gl/hTur8ZZs6Cmp1NLH8";
---

<BaseLayout title="Contact & Request Samples | Sibu Trading PLC" description="Contact Sibu Trading PLC about Ethiopian coffee availability, samples and buyer requirements.">
  <PageHero eyebrow="Contact" title="Start with your coffee requirements" description="Share the origin, process, preparation and volume you need. The Sibu team can respond with relevant availability and next steps." image={warehouse} alt="Prepared Ethiopian green coffee in a warehouse" />

  <section class="section section--cream">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">Sibu Trading PLC</p>
        <h2 class="section-title">Let’s talk coffee</h2>
        <dl class="contact-list">
          <div><dt>Address</dt><dd>{contact.address}<br />{contact.poBox}</dd></div>
          <div><dt>Telephone</dt><dd><a href={`tel:${contact.telephone.replace(/\s/g, "")}`}>{contact.telephone}</a></dd></div>
          <div><dt>Mobile</dt><dd>{contact.mobiles.map((mobile) => <a style="display:block" href={`tel:${mobile.replace(/\s/g, "")}`}>{mobile}</a>)}</dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
        </dl>
      </div>
      <div>
        <EnquiryForm client:visible email={contact.email} sitekey={turnstileSitekey} />
        <p class="contact-privacy-note">We use your details to respond to your enquiry. Read our <a href={withBase("/privacy/")}>Privacy Policy</a>.</p>
      </div>
    </div>
  </section>

  <section class="section contact-location" aria-labelledby="contact-location-title">
    <div class="shell">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Visit our office</p>
          <h2 class="section-title" id="contact-location-title">Find Sibu in Addis Ababa</h2>
        </div>
        <div>
          <p class="section-lead">4th Floor, Adot Building, South African Street, Addis Ababa, Ethiopia.</p>
          <a class="text-link" href={officeDirectionsUrl} target="_blank" rel="noopener noreferrer">Open directions in Google Maps</a>
        </div>
      </div>
      <iframe
        class="contact-location__map"
        title="Map showing Adot Building in Addis Ababa"
        src={officeMapUrl}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </section>
</BaseLayout>
