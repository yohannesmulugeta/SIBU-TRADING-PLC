---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryPreview from "../components/GalleryPreview.astro";
import ProfileMetrics from "../components/ProfileMetrics.astro";
import ScrollHero from "../components/ScrollHero";
import { certifications, companyStats } from "../data/site";
import { withBase } from "../lib/paths";
import heroAerial from "../assets/media/hero-aerial.webp";
import coffeePicker from "../assets/media/coffee-picker.webp";
import sortingLine from "../assets/media/sorting-line.webp";
import wetProcessing from "../assets/media/wet-processing.webp";
import qualityReview from "../assets/media/quality-review.webp";
import greenCoffee from "../assets/media/green-coffee.webp";
import communityTeam from "../assets/media/community-team.webp";
import aerialScale from "../assets/media/aerial-scale.webp";
---

<BaseLayout
  title="Sibu Trading PLC | Ethiopian Coffee from Guji"
  description="Three generations of Ethiopian coffee experience, connecting Guji origins with specialty buyers around the world."
  image={heroAerial.src}
>
  <ScrollHero
    client:load
    poster={withBase("/video/coffee-poster.jpg")}
    lowVideoSrc={withBase("/video/coffee-scrub-low.mp4")}
    sdVideoSrc={withBase("/video/coffee-scrub-sd.mp4")}
    hdVideoSrc={withBase("/video/coffee-scrub-hd.mp4")}
  />

  <section class="section story-intro" aria-labelledby="sibu-story-title">
    <div class="shell split story-intro__grid">
      <div class="story-intro__copy">
        <p class="eyebrow">The Sibu story</p>
        <h2 id="sibu-story-title" class="section-title story-intro__title">Before Sibu became a company, coffee was already our heritage.</h2>
        <p class="section-lead">The family’s relationship with coffee began through production, collection and trade in Guji. In 2014, that experience became Sibu Trading PLC—connecting inherited knowledge with modern specialty coffee and international buyers.</p>
        <div class="story-intro__facts" aria-label="Sibu story facts">
          <div><strong>2014</strong><span>Sibu Trading PLC established</span></div>
          <div><strong>Guji</strong><span>The origin of the family legacy</span></div>
        </div>
        <a class="text-link story-intro__link" href={withBase("/our-story/")}>Read the complete story</a>
      </div>
      <figure class="image-frame story-intro__media">
        <Image src={coffeePicker} alt="Coffee picker harvesting ripe cherries in a forested coffee farm" widths={[560, 900, 1200]} sizes="(max-width: 980px) 100vw, 50vw" />
        <figcaption>Coffee harvesting in Ethiopia’s highlands</figcaption>
      </figure>
    </div>
  </section>

  <section id="company-scale" class="section section--dark profile-proof" aria-labelledby="profile-proof-title">
    <div class="shell">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Sibu at a glance</p>
          <h2 id="profile-proof-title" class="section-title">Built to protect quality at scale</h2>
        </div>
        <p class="section-lead">A vertically connected operation across farmers, processing, preparation and export.</p>
      </div>
      <ProfileMetrics stats={companyStats} />
      <p class="profile-note">Figures reported in Sibu’s company profile. Current operating figures are confirmed directly for buyer due diligence.</p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="shell">
      <p class="eyebrow">From farm to export</p>
      <h2 class="section-title">Quality protected at every stage</h2>
      <p class="section-lead">Sibu participates across the value chain, connecting harvest, processing, drying, quality control, warehousing and export preparation.</p>
      <div class="card-grid">
        <article class="editorial-card">
          <Image src={sortingLine} alt="Coffee workers sorting parchment on raised drying beds" widths={[540, 900]} sizes="(max-width: 700px) 100vw, 33vw" />
          <div class="editorial-card__content"><h3>People</h3><p>Skilled hands protect quality from the first selection.</p></div>
        </article>
        <article class="editorial-card">
          <Image src={wetProcessing} alt="Coffee workers managing wet processing" widths={[540, 900]} sizes="(max-width: 700px) 100vw, 33vw" />
          <div class="editorial-card__content"><h3>Process</h3><p>Washed, natural and selected specialty preparations.</p></div>
        </article>
        <article class="editorial-card">
          <Image src={qualityReview} alt="Coffee team reviewing green beans in a warehouse" widths={[540, 900]} sizes="(max-width: 980px) 100vw, 33vw" />
          <div class="editorial-card__content"><h3>Proof</h3><p>Preparation and quality are reviewed before shipment.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="video-panel">
    <video muted loop playsinline preload="none" poster={aerialScale.src} data-lazy-video>
      <source data-src={withBase("/video/processing.mp4")} type="video/mp4" />
    </video>
    <div class="video-panel__overlay">
      <div>
        <p class="eyebrow">The work behind every lot</p>
        <h2>From Guji’s highlands to the customer’s warehouse.</h2>
      </div>
    </div>
  </section>

  <section id="coffee-portfolio" class="section">
    <div class="shell split">
      <div class="image-frame image-frame--portrait">
        <Image src={greenCoffee} alt="Close view of prepared Ethiopian green coffee" widths={[560, 900, 1200]} sizes="(max-width: 980px) 100vw, 50vw" />
      </div>
      <div>
        <p class="eyebrow">Coffee portfolio</p>
        <h2 class="section-title">Distinctive lots and reliable programs</h2>
        <p class="section-lead">Sibu works with specialty roasters, importers, traders, distributors and commercial buyers seeking Ethiopian coffee prepared to clear specifications.</p>
        <div class="stats-row coffee-programs">
          <div class="stat"><strong>Natural</strong><span>Fruit intensity and sweetness</span></div>
          <div class="stat"><strong>Washed</strong><span>Clean, bright cup profiles</span></div>
          <div class="stat"><strong>Honey</strong><span>Clarity with retained sweetness</span></div>
          <div class="stat"><strong>Specialty</strong><span>Traceable, separated lots</span></div>
        </div>
        <a class="text-link" href={withBase("/coffee-processing/")}>View coffee and processing</a>
      </div>
    </div>
  </section>

  <section class="section section--cream certification-preview" aria-labelledby="certification-preview-title">
    <div class="shell">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Certification programs</p>
          <h2 id="certification-preview-title" class="section-title">Structured for responsible sourcing</h2>
        </div>
        <div>
          <p class="section-lead">Programs referenced in the company profile. Eligibility remains specific to crop year, farm, station and lot.</p>
          <a class="text-link" href={withBase("/quality-impact/")}>Review certification status</a>
        </div>
      </div>
      <div class="certification-mini-grid">
        {certifications.map((certification) => (
          <article>
            <span>{certification.number}</span>
            <h3>{certification.name}</h3>
            <p>Program referenced</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <GalleryPreview />

  <section class="section section--cream">
    <div class="shell split">
      <div>
        <p class="eyebrow">People behind the coffee</p>
        <h2 class="section-title">The value of Ethiopian coffee is human.</h2>
        <p class="section-lead">Behind each prepared lot are farming families, seasonal teams, station workers, quality professionals and export coordinators.</p>
        <a class="button" href={withBase("/quality-impact/")}>Quality & impact</a>
      </div>
      <div class="image-frame image-frame--portrait">
        <Image src={communityTeam} alt="Members of a coffee-producing community at a drying station" widths={[560, 900, 1200]} sizes="(max-width: 980px) 100vw, 50vw" />
      </div>
    </div>
  </section>

  <section id="contact-cta" class="section section--dark buyer-cta">
    <div class="shell split buyer-cta__grid">
      <div class="buyer-cta__heading">
        <p class="eyebrow">Start a conversation</p>
        <h2 class="section-title">Looking for Ethiopian coffee with a clear connection to origin?</h2>
      </div>
      <div class="buyer-cta__action">
        <p class="section-lead">Tell us the origin, process, preparation and volume you need. Sibu will respond with relevant availability and next steps.</p>
        <a class="button button--light" href={withBase("/contact/")}>Request samples</a>
      </div>
    </div>
  </section>

  <script>
    const videos = document.querySelectorAll("[data-lazy-video]");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const video = entry.target;
        if (!(video instanceof HTMLVideoElement)) return;
        const source = video.querySelector("source[data-src]");
        if (source instanceof HTMLSourceElement && source.dataset.src) {
          source.src = source.dataset.src;
          source.removeAttribute("data-src");
          video.load();
          if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) video.play().catch(() => undefined);
        }
        observer.unobserve(video);
      });
    }, { rootMargin: "200px" });
    videos.forEach((video) => observer.observe(video));
  </script>
</BaseLayout>
