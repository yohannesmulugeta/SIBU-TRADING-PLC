---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
---

<BaseLayout title="Page not found | Sibu Trading PLC" description="The page you requested could not be found. Continue to the Sibu Trading home page or contact our team." noindex>
  <section class="utility-hero utility-hero--not-found" aria-labelledby="not-found-title">
    <div class="shell utility-hero__inner">
      <p class="eyebrow">404 · Page not found</p>
      <h1 id="not-found-title">Let’s get you back to Sibu.</h1>
      <p>The address may have changed, or the page may no longer be available.</p>
      <div class="utility-actions">
        <a class="button button--light" href={withBase("/")}>Go to Home</a>
        <a class="button button--outline" href={withBase("/contact/")}>Contact Sibu</a>
      </div>
    </div>
  </section>
</BaseLayout>
