---
import { Image } from "astro:assets";
import { recognitionCategories, recognitionItems } from "../data/recognition";
---

<section class="section recognition-collection" data-recognition-collection aria-labelledby="recognition-collection-title">
  <div class="shell">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">The complete collection</p>
        <h2 id="recognition-collection-title" class="section-title">Documents and awards, clearly presented</h2>
      </div>
      <p class="section-lead">Every item is shown as supplied. Historical and expired documents are labelled plainly and do not establish current certification or lot eligibility.</p>
    </div>

    <div class="gallery-filters" role="group" aria-label="Filter recognition items">
      <button type="button" data-recognition-filter="All" aria-pressed="true">All</button>
      {recognitionCategories.map((category) => (
        <button type="button" data-recognition-filter={category} aria-pressed="false">{category}</button>
      ))}
    </div>

    <div class="recognition-grid" data-recognition-grid>
      {recognitionItems.map((item) => (
        <button
          id={item.id}
          class="recognition-card"
          type="button"
          data-recognition-card
          data-category={item.category}
          data-full-src={item.image.src}
          data-title={item.title}
          data-issuer={item.issuer}
          data-recipient={item.recipient}
          data-year={item.year}
          data-status={item.status}
          data-summary={item.summary}
          data-alt={item.alt}
          aria-label={`Open ${item.title}`}
        >
          <span class="recognition-card__media">
            <Image
              src={item.image}
              alt={item.alt}
              widths={[360, 640, 960]}
              sizes="(max-width: 700px) 100vw, (max-width: 1050px) 50vw, 33vw"
              loading="lazy"
            />
          </span>
          <span class="recognition-card__content">
            <small>{item.category} · {item.year}</small>
            <strong>{item.title}</strong>
            <span>{item.issuer}</span>
            <em>{item.status}</em>
          </span>
        </button>
      ))}
    </div>
  </div>

  <dialog class="gallery-dialog recognition-dialog" data-recognition-dialog aria-labelledby="recognition-dialog-title" aria-describedby="recognition-dialog-summary">
    <button class="gallery-dialog__close" type="button" data-dialog-close aria-label="Close recognition">×</button>
    <button class="gallery-dialog__nav gallery-dialog__nav--previous" type="button" data-dialog-previous aria-label="Previous recognition">←</button>
    <figure>
      <img
        data-dialog-image
        src={recognitionItems[0].image.src}
        alt={recognitionItems[0].alt}
        width={recognitionItems[0].image.width}
        height={recognitionItems[0].image.height}
      />
      <figcaption>
        <p data-dialog-category>{recognitionItems[0].category}</p>
        <h2 id="recognition-dialog-title" data-dialog-title>{recognitionItems[0].title}</h2>
        <strong data-dialog-status>{recognitionItems[0].status}</strong>
        <dl class="recognition-dialog__details">
          <div><dt>Issuer</dt><dd data-dialog-issuer>{recognitionItems[0].issuer}</dd></div>
          <div><dt>Recipient</dt><dd data-dialog-recipient>{recognitionItems[0].recipient}</dd></div>
          <div><dt>Year</dt><dd data-dialog-year>{recognitionItems[0].year}</dd></div>
        </dl>
        <span id="recognition-dialog-summary" data-dialog-summary>{recognitionItems[0].summary}</span>
      </figcaption>
    </figure>
    <button class="gallery-dialog__nav gallery-dialog__nav--next" type="button" data-dialog-next aria-label="Next recognition">→</button>
  </dialog>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-recognition-collection]");
  const dialog = root?.querySelector<HTMLDialogElement>("[data-recognition-dialog]");
  const cards = Array.from(root?.querySelectorAll<HTMLButtonElement>("[data-recognition-card]") ?? []);
  const filters = Array.from(root?.querySelectorAll<HTMLButtonElement>("[data-recognition-filter]") ?? []);
  const dialogImage = dialog?.querySelector<HTMLImageElement>("[data-dialog-image]");
  const fields = {
    title: dialog?.querySelector<HTMLElement>("[data-dialog-title]"),
    category: dialog?.querySelector<HTMLElement>("[data-dialog-category]"),
    issuer: dialog?.querySelector<HTMLElement>("[data-dialog-issuer]"),
    recipient: dialog?.querySelector<HTMLElement>("[data-dialog-recipient]"),
    year: dialog?.querySelector<HTMLElement>("[data-dialog-year]"),
    status: dialog?.querySelector<HTMLElement>("[data-dialog-status]"),
    summary: dialog?.querySelector<HTMLElement>("[data-dialog-summary]"),
  };
  let currentIndex = 0;
  let lastFocused: HTMLElement | null = null;

  const visibleCards = () => cards.filter((card) => !card.hidden);

  const showCard = (card: HTMLButtonElement) => {
    const visible = visibleCards();
    currentIndex = Math.max(0, visible.indexOf(card));
    lastFocused = card;
    if (dialogImage) {
      dialogImage.src = card.dataset.fullSrc ?? "";
      dialogImage.alt = card.dataset.alt ?? "";
    }
    Object.entries(fields).forEach(([name, field]) => {
      if (field) field.textContent = card.dataset[name] ?? "";
    });
    if (dialog && !dialog.open) dialog.showModal();
    document.documentElement.classList.add("gallery-dialog-open");
    requestAnimationFrame(() => dialog?.querySelector<HTMLButtonElement>("[data-dialog-close]")?.focus());
  };

  const move = (direction: number) => {
    const visible = visibleCards();
    if (!visible.length) return;
    currentIndex = (currentIndex + direction + visible.length) % visible.length;
    showCard(visible[currentIndex]);
  };

  filters.forEach((filter) => {
    filter.addEventListener("click", () => {
      const selected = filter.dataset.recognitionFilter ?? "All";
      filters.forEach((button) => button.setAttribute("aria-pressed", String(button === filter)));
      cards.forEach((card) => {
        card.hidden = selected !== "All" && card.dataset.category !== selected;
      });
    });
  });

  cards.forEach((card) => card.addEventListener("click", () => showCard(card)));
  dialog?.querySelector("[data-dialog-close]")?.addEventListener("click", () => dialog.close());
  dialog?.querySelector("[data-dialog-previous]")?.addEventListener("click", () => move(-1));
  dialog?.querySelector("[data-dialog-next]")?.addEventListener("click", () => move(1));
  dialog?.addEventListener("close", () => {
    document.documentElement.classList.remove("gallery-dialog-open");
    lastFocused?.focus();
  });
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") move(-1);
    if (event.key === "ArrowRight") move(1);
  });
</script>
