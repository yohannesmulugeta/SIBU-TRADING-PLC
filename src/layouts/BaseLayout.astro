---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";
import socialPreview from "../assets/media/hero-aerial.webp";
import { contact } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = socialPreview.src, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://sibutradingplc.com/#organization",
  name: "Sibu Trading PLC",
  url: "https://sibutradingplc.com/",
  email: contact.email,
  telephone: contact.telephone,
  address: {
    "@type": "PostalAddress",
    streetAddress: "4th Floor, Adot Building, South African Street",
    addressLocality: "Addis Ababa",
    addressCountry: "ET",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2b3d2a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sibu Trading PLC" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Sibu Trading coffee operations in Guji, Ethiopia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, "\\u003c")} />}
    {import.meta.env.PROD && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"d209cd9f32b24fbbbbeeec94b18b2095"}'></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
