---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";
import socialPreview from "../assets/media/hero-aerial.webp";
import { contact } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = socialPreview.src, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://sibutradingplc.com/#organization",
  name: "Sibu Trading PLC",
  url: "https://sibutradingplc.com/",
  email: contact.email,
  telephone: contact.telephone,
  address: {
    "@type": "PostalAddress",
    streetAddress: "4th Floor, Adot Building, South African Street",
    addressLocality: "Addis Ababa",
    addressCountry: "ET",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href={`${withBase("/favicon.png")}?v=heritage-bowl`} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2b3d2a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sibu Trading PLC" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Sibu Trading coffee operations in Guji, Ethiopia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, "\\u003c")} />}
    {import.meta.env.PROD && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"d209cd9f32b24fbbbbeeec94b18b2095"}'></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <a class="whatsapp-button" href={`https://wa.me/${contact.whatsapp.replace(/\D/g, "")}`} target="_blank" rel="noopener noreferrer" aria-label={`Message Sibu Trading PLC on WhatsApp at ${contact.whatsapp}`} title="Message Sibu on WhatsApp">
      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6a10.5 10.5 0 0 1-5.4-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2c-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-2.5-1.6 9.3 9.3 0 0 1-1.8-2.2c-.2-.3 0-.5.2-.7l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.1 1.1-1.1 2.5 1.1 2.9 1.2 1.6 3.6 4.2 6.2 4.5c.9.1 1.6.1 2.2-.1.7-.2 1.8-1 2-2 .2-1 .2-1.8.1-2-.1-.2-.3-.3-.6-.5Z"/></svg>
      <span>WhatsApp</span>
    </a>
  </body>
</html>
