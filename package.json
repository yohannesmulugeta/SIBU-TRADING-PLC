    "types:worker": "wrangler types --include-runtime false",
    "check:worker": "tsc --project tsconfig.worker.json"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
