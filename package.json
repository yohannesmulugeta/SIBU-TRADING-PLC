  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run check && npm run check:worker && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:recognition": "node scripts/prepare-recognition-media.mjs",
    "deploy": "wrangler deploy",
