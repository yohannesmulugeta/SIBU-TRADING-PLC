{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sibu-trading-plc",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sibutradingplc.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "ENQUIRY_EMAIL" }],
  "ratelimits": [{
    "name": "ENQUIRY_LIMITER",
    "namespace_id": "73120481",
    "simple": { "limit": 10, "period": 60 }
  }],
  "vars": { "CONTACT_EMAIL": "sibucoffee.ethio@gmail.com" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "head_sampling_rate": 1
  }
}
